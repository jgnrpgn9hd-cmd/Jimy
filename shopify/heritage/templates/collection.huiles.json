            "acc": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "rte"
              },
              "blocks": {
                "r1": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Quels sont les délais de livraison ?",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Votre commande est préparée sous 1 à 3 jours ouvrés, puis livrée en France métropolitaine sous 6 à 8 jours ouvrés.</p>",
                        "width": "100%",
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": [
                    "t"
                  ]
                },
                "r2": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Comment conserver mon huile ?",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Bien fermée, à l'abri de la lumière et de la chaleur. Évitez de la garder à côté des plaques de cuisson.</p>",
                        "width": "100%",
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": [
                    "t"
                  ]
                },
                "r3": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Une bouteille est arrivée cassée, que faire ?",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Écrivez-nous sous 48 heures avec une photo à davicojairo09@gmail.com. Nous vous la renvoyons ou nous vous remboursons.</p>",
                        "width": "100%",
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": [
                    "t"
                  ]
                }
