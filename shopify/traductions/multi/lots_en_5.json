atableContentDigest": "08118c102ee4ebaf9079e43afc9ce8015d3298f2df5c5a69622532d33f0693ee"}, {"locale": "en", "key": "section.collection.huiles.json.choisir.cols__c3__h.text:17oyj44ax906o", "value": "<h3>To give as a gift</h3>", "translatableContentDigest": "f9377e02a5a99aa84c45c0b247a12d25725e26130400b9e6a082cfcc862111fd"}, {"locale": "en", "key": "section.collection.huiles.json.choisir.cols__c3__p.text:2hsofxgl4gu20", "value": "<p>The tasting box. Hojiblanca, Arbosana and Picual, to compare side by side.</p>", "translatableContentDigest": "6476605b38bd673fb04d5bb9c7c7d79063fb21a1e6fc9a22cff25f550c334893"}, {"locale": "en", "key": "section.collection.huiles.json.choisir.cols__c3__b.label:13fkl78s2izi9", "value": "See the box", "translatableContentDigest": "c3a8495393588225a11a02eb87a139c3366db0c66032c2e0a7358bd8a76eead0"}, {"locale": "en", "key": "section.collection.huiles.json.faq.t.text:37p4ws7vbyhzw", "value": "<h2>Frequently asked questions</h2>", "translatableContentDigest": "ea2f490fae7cf95b9f91f1ae2c7cb1716dc1b9b6a31fcc111e13a5f7cb7e6da4"}, {"locale": "en", "key": "section.collection.huiles.json.faq.wrap__acc__r1.heading:2bb7kmzecgunf", "value": "How long does delivery take?", "translatableContentDigest": "996086b889f0a9af413b74e9054bd0c4456af64a9ce2e1696ab9e398be7983ad"}, {"locale": "en", "key": "section.collection.huiles.json.faq.wrap__acc__r1__t.text:pukfe4kydn3e", "value": "<p>We ship from Paris with Chronopost. Delivery across Europe takes 2 to 5 working days.</p>", "translatableContentDigest": "2734d3b8538731fd0ae523e9598db31b07173c9535451224dba0ba26bb07f729"}, {"locale": "en", "key": "section.collection.huiles.json.faq.wrap__acc__r2.heading:3vvm74t1yf83s", "value": "How should I store my oil?", "translatableContentDigest": "0f892362af7dccf61fc5e2babfc2b936efa5ed5efe8f62b45f7ebc8f6ea70707"}, {"locale": "en", "key": "section.collection.huiles.json.faq.wrap__acc__r2__t.text:21shd79kgoll5", "value": "<p>Tightly closed, away from light and heat. Avoid keeping it next to the hob.</p>", "translatableContentDigest": "0a8a4d650d7678f4536efdf6fd00712e245c0017ba7d8ddcd442aa84878bb8c8"}]}