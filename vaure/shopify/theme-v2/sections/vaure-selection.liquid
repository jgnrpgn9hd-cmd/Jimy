{%- comment -%}
  VAURE – Sélection mise en avant : une grande photo d'ambiance + 4 produits choisis
  (2e photo au survol, vrais prix lus sur les fiches). Léger : images en lazy-load, CSS seul.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="vsel" style="--vsel-pt: {{ s.padding_top }}px; --vsel-pb: {{ s.padding_bottom }}px;">
  <div class="vsel__in">
    <div class="vsel__tete">
      {%- if s.kicker != blank -%}<p class="vsel__k">{{ s.kicker }}</p>{%- endif -%}
      <h2 class="vsel__h">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="vsel__p">{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="vsel__grille">
      {%- if s.image != blank -%}
        <div class="vsel__ambiance">
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '600, 900, 1200', alt: s.image.alt }}
          {%- if s.image_label != blank -%}<span class="vsel__badge">{{ s.image_label }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      <ul class="vsel__produits">
        {%- for i in (1..4) -%}
          {%- assign key = 'p' | append: i -%}
          {%- assign p = s[key] -%}
          {%- if p != blank -%}
            <li>
              <a class="vsel__carte" href="{{ p.url }}">
                <span class="vsel__img">
                  {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 22vw, 50vw', widths: '350, 500, 700', alt: p.featured_image.alt | default: p.title }}
                  {%- if p.images[1] -%}{{ p.images[1] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'vsel__img2', sizes: '(min-width: 990px) 22vw, 50vw', widths: '350, 500, 700', alt: '' }}{%- endif -%}
                </span>
                <span class="vsel__nom">{{ p.title }}</span>
                <span class="vsel__prix">{{ p.price | money }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    {%- if s.button != blank -%}
      <div class="vsel__pied"><a class="vsel__btn" href="{{ s.button_url | default: '/collections/bracelets' }}">{{ s.button }}</a>{%- if s.note != blank -%}<span class="vsel__note">{{ s.note }}</span>{%- endif -%}</div>
    {%- endif -%}
  </div>
</div>
<style>
  .vsel{background:#EFE7DC;padding:var(--vsel-pt) 0 var(--vsel-pb);color:#151412}
  .vsel__in{max-width:1240px;margin:0 auto;padding-inline:clamp(20px,4vw,48px)}
  .vsel__tete{text-align:center;max-width:640px;margin:0 auto clamp(28px,4vw,48px)}
  .vsel__k{font-family:Manrope,system-ui,sans-serif;font-size:12px;letter-spacing:.32em;color:#8A6A3A;font-weight:700;margin:0 0 14px;text-transform:uppercase}
  .vsel__h{font-family:'Bodoni Moda',Georgia,serif;font-weight:400;font-size:clamp(38px,5vw,64px);line-height:1;margin:0 0 14px}
  .vsel__p{font-family:Manrope,system-ui,sans-serif;font-size:16px;line-height:1.55;color:#3a352f;margin:0}
  .vsel__grille{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(16px,2.4vw,32px);align-items:stretch}
  .vsel__ambiance{position:relative;overflow:hidden;min-height:100%}
  .vsel__ambiance img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.4s cubic-bezier(.2,.7,.2,1)}
  .vsel__ambiance:hover img{transform:scale(1.03)}
  .vsel__badge{position:absolute;left:16px;bottom:16px;background:#F8F5F0;color:#151412;font-family:Manrope,system-ui,sans-serif;font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;padding:9px 14px}
  .vsel__produits{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:clamp(12px,1.8vw,24px)}
  .vsel__carte{display:block;text-decoration:none;color:#151412;font-family:Manrope,system-ui,sans-serif}
  .vsel__img{position:relative;display:block;aspect-ratio:1/1;overflow:hidden;background:#F8F5F0;margin-bottom:10px}
  .vsel__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .5s ease,transform .9s cubic-bezier(.2,.7,.2,1)}
  .vsel__img .vsel__img2{opacity:0}
  .vsel__carte:hover .vsel__img img{transform:scale(1.04)}
  .vsel__carte:hover .vsel__img .vsel__img2{opacity:1}
  .vsel__nom{display:block;font-size:15px;font-weight:600}
  .vsel__prix{display:block;font-size:14px;color:#3a352f;margin-top:2px}
  .vsel__pied{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;justify-content:center;margin-top:clamp(24px,3vw,40px)}
  .vsel__btn{display:inline-block;background:#151412;color:#F8F5F0;font-family:Manrope,system-ui,sans-serif;font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase;padding:16px 30px;text-decoration:none;transition:background .3s}
  .vsel__btn:hover{background:#8A6A3A}
  .vsel__note{font-family:Manrope,system-ui,sans-serif;font-size:14px;color:#3a352f}
  @media (max-width:749px){
    .vsel__grille{grid-template-columns:1fr}
    .vsel__ambiance{aspect-ratio:4/5}
  }
  @media (hover:none){.vsel__img .vsel__img2{display:none}}
  @media (prefers-reduced-motion:reduce){.vsel *{transition:none!important}}
</style>
{% schema %}
{
  "name": "VAURE – Sélection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "Nos coups de cœur" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'accumulation" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "image_picker", "id": "image", "label": "Photo d'ambiance" },
    { "type": "text", "id": "image_label", "label": "Étiquette sur la photo" },
    { "type": "product", "id": "p1", "label": "Produit 1" },
    { "type": "product", "id": "p2", "label": "Produit 2" },
    { "type": "product", "id": "p3", "label": "Produit 3" },
    { "type": "product", "id": "p4", "label": "Produit 4" },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Tous les bracelets" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" },
    { "type": "text", "id": "note", "label": "Petite note à côté du bouton" },
    { "type": "range", "id": "padding_top", "label": "Marge haut", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Marge bas", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "VAURE – Sélection" }]
}
{% endschema %}
