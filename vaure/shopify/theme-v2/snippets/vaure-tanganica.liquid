{%- comment -%}
  Pixel Tanganica (Google Tag Manager GTM-TRS5RSN).
  RGPD : chargé uniquement si la visiteuse accepte les cookies marketing
  (bannière de consentement Shopify), ou hors zone où le consentement est demandé.
{%- endcomment -%}
<!-- Tanganica pixel -->
<script>
  (function () {
    var charge = false;
    function gtm() {
      if (charge) return; charge = true;
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0], j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TRS5RSN');
    }
    function verifier() {
      var cp = window.Shopify && window.Shopify.customerPrivacy;
      if (cp && typeof cp.marketingAllowed === 'function' && cp.marketingAllowed()) gtm();
    }
    function init() {
      if (window.Shopify && window.Shopify.loadFeatures) {
        window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (err) { if (!err) verifier(); });
      }
    }
    document.addEventListener('visitorConsentCollected', function (e) {
      if (e.detail && e.detail.marketingAllowed) gtm();
    });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
<!-- End Tanganica pixel -->
