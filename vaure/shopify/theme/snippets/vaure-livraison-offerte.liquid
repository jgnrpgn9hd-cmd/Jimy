{%- doc -%}
  VAURE : barre de progression vers la livraison offerte (35 €).
  Appelé en haut de snippets/cart-summary.liquid : {% render 'vaure-livraison-offerte' %}
{%- enddoc -%}
{%- unless cart.empty? or cart.currency.iso_code != 'EUR' -%}
  {%- assign vaure_seuil = 3500 -%}
  {%- assign vaure_pct = cart.total_price | times: 100 | divided_by: vaure_seuil | at_most: 100 -%}
  <div class="vaure-livraison" role="status">
    {%- if cart.total_price >= vaure_seuil -%}
      <p class="vaure-livraison__texte">✓ La livraison est <strong>offerte</strong></p>
    {%- else -%}
      {%- assign vaure_reste = vaure_seuil | minus: cart.total_price -%}
      <p class="vaure-livraison__texte">Plus que <strong>{{ vaure_reste | money }}</strong> pour la livraison offerte</p>
    {%- endif -%}
    <div class="vaure-livraison__barre"><span style="width: {{ vaure_pct }}%"></span></div>
  </div>
  {%- liquid
    assign vaure_qte = 0
    for item in cart.items
      if item.product.vendor == 'VAURE'
        assign vaure_qte = vaure_qte | plus: item.quantity
      endif
    endfor
  -%}
  {%- if vaure_qte == 1 -%}
    <p class="vaure-livraison__duo">✦ Ajoutez 1 article VAURE : <strong>−10 % sur les deux</strong>, appliqué automatiquement</p>
  {%- elsif vaure_qte >= 2 -%}
    <p class="vaure-livraison__duo">✦ Offre duo activée : <strong>−10 %</strong> sur vos articles VAURE</p>
  {%- endif -%}
  <style>
    .vaure-livraison{display:flex;flex-direction:column;gap:8px;width:100%;margin-block-end:12px}
    .vaure-livraison__texte{margin:0;font-size:.8125rem;letter-spacing:.02em}
    .vaure-livraison__barre{height:3px;width:100%;background:rgb(var(--color-foreground-rgb,0 0 0) / .12);overflow:hidden}
    .vaure-livraison__duo{margin:-4px 0 12px;font-size:.8125rem;color:#8a6a3a}
    .vaure-livraison__barre span{display:block;height:100%;background:#B08D57;transition:width .4s ease}
  </style>
{%- endunless -%}
{% render 'vaure-panier-suggestions' %}
