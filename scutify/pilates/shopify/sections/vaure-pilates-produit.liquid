<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@400;500;600&display=swap">
<style>
  .vpp{--choco:#552b1d;--ink:#2b1710;--cream:#f4ece2;--paper:#fbf7f2;--fluo:#2ef27a;--muted:#7a5a48;--line:#e7dccd;font-family:'Inter',system-ui,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.6}
  .vpp *{box-sizing:border-box}
  .vpp h1,.vpp h2,.vpp h3{font-family:'Outfit',sans-serif;letter-spacing:-.02em;margin:0;text-wrap:balance}
  .vpp p{margin:0}
  .vpp .in{max-width:1200px;margin:0 auto;padding:0 24px}
  .vpp .k{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--muted);display:flex;align-items:center;gap:10px}
  .vpp .k::before{content:"";width:24px;height:2px;background:var(--fluo)}
  .vpp-top{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;padding:48px 24px 96px;max-width:1200px;margin:0 auto;align-items:start}
  .vpp-gal{display:grid;gap:12px;position:sticky;top:96px}
  .vpp-gal img{width:100%;height:auto;border-radius:24px;display:block;background:var(--cream)}
  .vpp-gal .thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .vpp-ph{aspect-ratio:1/1;border-radius:28px;background:radial-gradient(90% 80% at 50% 45%,#fffaf4 0%,var(--cream) 60%,#e6d7c5 100%);display:grid;place-items:center;color:var(--ink);position:relative;overflow:hidden}
  .vpp-ph .vaure-logo{height:54px}
  .vpp-ph small{position:absolute;bottom:22px;left:0;right:0;text-align:center;font-size:13px;color:var(--muted)}
  .vpp-info h1{font-size:clamp(34px,4vw,52px);font-weight:600;line-height:1.02;margin:16px 0 14px}
  .vpp-price{display:flex;align-items:baseline;gap:12px;margin:6px 0 18px}
  .vpp-price b{font-family:'Outfit',sans-serif;font-size:34px;font-weight:600;letter-spacing:-.02em}
  .vpp-price span{font-size:14px;color:var(--muted)}
  .vpp-lead{color:var(--muted);font-size:17px;max-width:46ch}
  .vpp-ticks{list-style:none;padding:0;margin:24px 0;display:grid;gap:10px}
  .vpp-ticks li{display:flex;gap:10px;align-items:center;font-size:15px;font-weight:500}
  .vpp-ticks li::before{content:"✓";flex:none;display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--fluo);font-size:12px;font-weight:700}
  .vpp-buy{display:flex;gap:10px;margin-top:8px}
  .vpp-qty{display:flex;align-items:center;border:1px solid var(--line);border-radius:999px;background:#fff}
  .vpp-qty button{all:unset;cursor:pointer;width:44px;height:52px;display:grid;place-items:center;font-size:20px}
  .vpp-qty input{width:34px;border:0;text-align:center;font-size:16px;background:transparent;-moz-appearance:textfield}
  .vpp-btn{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--fluo);color:var(--ink);font-weight:600;font-size:16px;padding:16px 26px;border-radius:999px;border:0;cursor:pointer;text-decoration:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation;transition:transform .1s ease-out,box-shadow .25s ease}
  .vpp-btn:hover{box-shadow:0 12px 34px rgba(46,242,122,.4)}
  .vpp-btn:active{transform:scale(.97)}
  .vpp-btn[disabled]{background:var(--cream);color:var(--muted);cursor:default;box-shadow:none}
  .vpp-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px}
  .vpp-trust div{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:12px 14px;font-size:13px;color:var(--muted)}
  .vpp-trust b{display:block;color:var(--ink);font-size:14px}
  .vpp-desc{margin-top:28px;padding-top:24px;border-top:1px solid var(--line);color:var(--muted);font-size:15px}
  .vpp-desc h3{font-size:18px;color:var(--ink);margin:18px 0 8px}
  .vpp-desc ul{padding-left:20px;margin:0}
  .vpp-sec{padding:96px 0}
  .vpp-sec.alt{background:var(--cream)}
  .vpp-sec.dark{background:var(--choco);color:#fbf7f2}
  .vpp-sec.dark .k{color:#dcc7b4}
  .vpp-sec h2{font-size:clamp(30px,4vw,48px);font-weight:600;line-height:1.05;margin-top:18px;max-width:20ch}
  .vpp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:48px}
  .vpp-card{background:#fff;border-radius:20px;padding:22px}
  .vpp-card .n{font-family:'Outfit',sans-serif;font-size:13px;font-weight:600;color:var(--muted)}
  .vpp-card h3{font-size:20px;font-weight:600;margin:8px 0 6px}
  .vpp-card p{font-size:14px;color:var(--muted)}
  .vpp-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:48px}
  .vpp-steps .d{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--fluo);font-weight:600}
  .vpp-steps h3{font-size:22px;font-weight:600;margin:8px 0 6px}
  .vpp-steps p{color:#dcc7b4;font-size:15px}
  .vpp-faq{max-width:820px;margin-top:40px}
  .vpp-faq details{border-bottom:1px solid var(--line)}
  .vpp-faq summary{font-family:'Outfit',sans-serif;font-size:19px;font-weight:600;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:20px;padding:22px 0;-webkit-tap-highlight-color:transparent}
  .vpp-faq summary::-webkit-details-marker{display:none}
  .vpp-faq summary::after{content:"+";font-weight:400;font-size:24px;line-height:1;transition:transform .2s ease}
  .vpp-faq details[open] summary::after{transform:rotate(45deg)}
  .vpp-faq details p{color:var(--muted);padding:0 40px 22px 0}
  .vpp-safe{margin-top:28px;padding:18px 20px;border-radius:16px;background:#fff;font-size:14px;color:var(--muted)}
  .vpp-safe b{color:var(--ink)}
  @media (max-width:900px){
    .vpp-top{grid-template-columns:1fr;gap:28px;padding:20px 16px 64px}
    .vpp-gal{position:static}
    .vpp-grid{grid-template-columns:1fr 1fr}
    .vpp-steps{grid-template-columns:1fr 1fr}
    .vpp-trust{grid-template-columns:1fr}
    .vpp-sec{padding:64px 0}
    .vpp .in{padding:0 16px}
  }
  @media (max-width:520px){.vpp-grid,.vpp-steps{grid-template-columns:1fr}}
</style>

{%- assign v = product.selected_or_first_available_variant -%}
<div class="vpp">
  <div class="vpp-top">
    <div class="vpp-gal">
      {%- if product.media.size > 0 -%}
        {{ product.featured_media | image_url: width: 1400 | image_tag: loading: 'eager', alt: product.title, sizes: '(min-width: 900px) 55vw, 100vw' }}
        {%- if product.media.size > 1 -%}
          <div class="thumbs">
            {%- for m in product.media offset: 1 limit: 4 -%}{{ m | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title }}{%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="vpp-ph">{% render 'vaure-logo', height: 54, height_mobile: 40 %}<small>Photos du coffret très bientôt</small></div>
      {%- endif -%}
    </div>

    <div class="vpp-info">
      <span class="k">Le kit VAURE</span>
      <h1>{{ product.title }}</h1>
      <div class="vpp-price"><b>{{ v.price | money }}</b><span>Programme vidéo inclus</span></div>
      <p class="vpp-lead">Tout le matériel d'un studio de Pilates et un programme guidé, réunis dans un seul coffret. 15 minutes par jour, chez toi.</p>
      <ul class="vpp-ticks">
        <li>Tapis, cercle, ballon, 3 bandes, brique, sliders, rouleau</li>
        <li>Défi de 30 jours, puis une nouvelle séance chaque semaine</li>
        <li>Débutante bienvenue, en français</li>
      </ul>
      {%- if v.available -%}
        {%- form 'product', product, class: 'vpp-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          <div class="vpp-buy">
            <div class="vpp-qty"><button type="button" aria-label="Moins" data-q="-1">−</button><input type="number" name="quantity" value="1" min="1" aria-label="Quantité"><button type="button" aria-label="Plus" data-q="1">+</button></div>
            <button class="vpp-btn" type="submit" name="add">Ajouter au panier</button>
          </div>
        {%- endform -%}
      {%- else -%}
        <div class="vpp-buy"><a class="vpp-btn" href="/#vp-attente">Bientôt disponible · Me prévenir</a></div>
      {%- endif -%}
      <div class="vpp-trust">
        <div><b>Retours 30 jours</b>Si le kit ne te convient pas</div>
        <div><b>Paiement sécurisé</b>Paiement chiffré, sans frais cachés</div>
        <div><b>Livraison suivie</b>Numéro de suivi par e-mail</div>
      </div>
      {%- if product.description != blank -%}<div class="vpp-desc">{{ product.description }}</div>{%- endif -%}
    </div>
  </div>

  <section class="vpp-sec alt">
    <div class="in">
      <span class="k">Dans le coffret</span>
      <h2>8 pièces. Tout le studio.</h2>
      <div class="vpp-grid">
        <div class="vpp-card"><span class="n">01</span><h3>Le tapis</h3><p>Ta zone de séance, partout. Se roule et se range.</p></div>
        <div class="vpp-card"><span class="n">02</span><h3>Le cercle</h3><p>Il résiste quand tu le presses : bras, poitrine, cuisses.</p></div>
        <div class="vpp-card"><span class="n">03</span><h3>Le petit ballon</h3><p>Un peu d'instabilité pour travailler les muscles profonds.</p></div>
        <div class="vpp-card"><span class="n">04</span><h3>Les 3 bandes</h3><p>Trois résistances pour progresser à ton rythme.</p></div>
        <div class="vpp-card"><span class="n">05</span><h3>La brique</h3><p>Pour bien te placer, idéale quand on débute.</p></div>
        <div class="vpp-card"><span class="n">06</span><h3>Les 2 sliders</h3><p>Ils glissent au sol pour des mouvements fluides.</p></div>
        <div class="vpp-card"><span class="n">07</span><h3>Le rouleau</h3><p>En fin de séance, pour relâcher dos et jambes.</p></div>
        <div class="vpp-card"><span class="n">08</span><h3>Le programme</h3><p>Des séances vidéo de 15 minutes, en français.</p></div>
      </div>
    </div>
  </section>

  <section class="vpp-sec dark">
    <div class="in">
      <span class="k">Le défi VAURE</span>
      <h2>30 jours pour sentir la différence.</h2>
      <div class="vpp-steps">
        <div><p class="d">Jours 1 à 7</p><h3>Les bases</h3><p>Respiration, centre, posture.</p></div>
        <div><p class="d">Jours 8 à 14</p><h3>Gainage</h3><p>Avec le cercle et le ballon.</p></div>
        <div><p class="d">Jours 15 à 21</p><h3>Bas du corps</h3><p>Avec les bandes et les sliders.</p></div>
        <div><p class="d">Jours 22 à 30</p><h3>Enchaînements</h3><p>Des séances complètes, comme en studio.</p></div>
      </div>
    </div>
  </section>

  <section class="vpp-sec">
    <div class="in">
      <span class="k">Questions</span>
      <h2>Avant de commander.</h2>
      <div class="vpp-faq">
        <details><summary>Je suis débutante, c'est pour moi ?</summary><p>Oui. La première semaine sert à apprendre les bases, et chaque mouvement a une version plus facile.</p></details>
        <details><summary>J'ai un petit appartement, j'ai la place ?</summary><p>La place d'un tapis suffit, et tout le kit se range dans un placard.</p></details>
        <details><summary>Comment j'accède au programme ?</summary><p>Après ta commande, tu reçois ton accès au programme vidéo. Le défi dure 30 jours, puis une nouvelle séance arrive chaque semaine.</p></details>
        <details><summary>Quand vais-je recevoir mon kit ?</summary><p>La date estimée pour ton adresse est affichée avant le paiement. Tous les détails sont sur la page <a href="/pages/livraison">Livraison</a>.</p></details>
        <details><summary>Et s'il ne me convient pas ?</summary><p>Tu as 30 jours après réception pour le retourner. Voir <a href="/pages/retours">Retours et remboursements</a>.</p></details>
      </div>
      <div class="vpp-safe"><b>Ta sécurité d'abord.</b> Chaque séance commence par un échauffement. En cas de grossesse, de douleur ou de problème de dos, demande l'avis d'un professionnel de santé avant de commencer. VAURE parle de tonus, de posture et de bien-être, jamais de promesse médicale.</div>
    </div>
  </section>
</div>

<script>
document.querySelectorAll('.vpp-qty').forEach(function(q){var i=q.querySelector('input');q.querySelectorAll('button').forEach(function(b){b.addEventListener('click',function(){i.value=Math.max(1,(+i.value||1)+(+b.dataset.q));});});});
</script>

