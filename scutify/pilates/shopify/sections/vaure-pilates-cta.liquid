<style>
  .vcta{position:fixed;left:50%;bottom:16px;z-index:60;transform:translate(-50%,140%);transition:transform .45s cubic-bezier(.2,.9,.25,1);width:min(560px,calc(100% - 24px));
    display:flex;align-items:center;gap:14px;padding:10px 10px 10px 18px;border-radius:999px;background:rgba(43,23,16,.94);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
    color:#fbf7f2;font-family:'Inter',system-ui,sans-serif;box-shadow:0 18px 40px -12px rgba(20,11,8,.55);-webkit-font-smoothing:antialiased}
  .vcta.on{transform:translate(-50%,0)}
  .vcta .t{flex:1;min-width:0;line-height:1.25}
  .vcta .t b{display:block;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .vcta .t span{font-size:12px;color:#d9c6b5}
  .vcta a{flex:none;display:inline-flex;align-items:center;gap:8px;background:#2ef27a;color:#2b1710;font-weight:700;font-size:14px;padding:13px 18px;border-radius:999px;text-decoration:none;-webkit-tap-highlight-color:transparent;transition:transform .1s ease-out}
  .vcta a:active{transform:scale(.96)}
  @media (max-width:380px){.vcta .t span{display:none}.vcta a{padding:12px 14px}}
  @media (prefers-reduced-motion:reduce){.vcta{transition:none}}
  /* Liste d'attente : visuel du kit, prix et petites assurances */
  .vp .wait .wkit{display:block;width:min(260px,62vw);height:auto;margin:0 auto 34px;border-radius:24px;box-shadow:0 30px 60px -24px rgba(0,0,0,.6);transform:rotate(-3deg)}
  .vp .wait .wperks{list-style:none;padding:0;margin:28px auto 0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;font-size:14px;color:var(--soft,#d9c6b5)}
  .vp .wait .wperks li{display:flex;align-items:center;gap:8px}
  .vp .wait .wperks li::before{content:"";width:12px;height:2px;background:currentColor;opacity:.6}
  .vp .wait .msg a,.vp .wait .wperks a{color:inherit;text-underline-offset:3px}
  /* Page épurée : on retire les doublons */
  .vsb{display:none!important}                                  /* 2e barre collante (doublon de celle-ci) */
  .vsp{display:none!important}                                  /* bloc « −95 % » : trop « promo », on garde le constat chiffré plus sobre */
  .vp .compare{display:none!important}                          /* tableau comparatif : doublon du constat */
  .vc>.in{display:none!important}.vc .vc-pc{margin-top:0}       /* coffret : la photo du kit est déjà dans l'ouverture */
  .vc .vc-pc h3{font-size:clamp(30px,3.6vw,48px);margin-bottom:28px}
  /* Chaque bloc se termine par une action */
  .vnext{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:36px}
  .vnext a.p{display:inline-flex;align-items:center;gap:10px;padding:15px 24px;border-radius:999px;font-weight:600;font-size:15px;text-decoration:none;background:#2b1710;color:#fbf7f2;font-family:'Inter',system-ui,sans-serif;transition:transform .1s ease-out}
  .vnext a.p:active{transform:scale(.97)}
  .vnext a.s{font-size:15px;font-weight:600;color:inherit;text-underline-offset:4px;font-family:'Inter',system-ui,sans-serif}
  .vnext.dk a.p{background:#2ef27a;color:#2b1710}
  .vnext.ct{justify-content:center}
  /* Une seule typo de titres sur tout l'accueil (condensée sportive) */
  .vof h2,.vse h2,.vnv h2,.vc .vc-pc h3{font-family:'Barlow Condensed','Outfit',sans-serif!important;font-weight:800!important;text-transform:uppercase;letter-spacing:-.005em!important;line-height:.92!important;font-size:clamp(40px,5.4vw,76px)!important}
  .vof h2 em,.vse h2 em,.vnv h2 em,.vc .vc-pc h3 em{font-style:italic!important;font-weight:800!important;color:#552b1d!important}
  .v3-b h1 em,.v3-b h2 em{color:#552b1d!important}
  /* Légendes de la mosaïque lisibles sur les photos claires */
  .vto figure::after{content:"";position:absolute;left:0;right:0;bottom:0;height:42%;background:linear-gradient(180deg,rgba(20,11,8,0),rgba(20,11,8,.55));pointer-events:none}
  .vto figcaption{z-index:1}.vto figcaption span{font-size:13px!important;font-weight:600!important;padding:0!important}
  /* Bloc de réassurance en double avant l'inscription */
  .vp .promises{display:none!important}
  .vp .wait .wperks li{display:block}.vp .wait .wperks li::before{display:inline-block;vertical-align:middle;margin-right:8px}
</style>
<div class="vcta" id="vcta" aria-hidden="true">
  <div class="t"><b>Le kit VAURE · 39,90 €</b><span>8 pièces + le défi 30 jours guidé</span></div>
  <a href="#vp-attente" tabindex="-1">Être prévenue
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
</div>
<script>
(function(){var bar=document.getElementById('vcta');if(!bar)return;var link=bar.querySelector('a');
  var hero=document.querySelector('.v3'),form=document.getElementById('vp-attente'),formIn=false,t=false;
  if(form&&window.IntersectionObserver)new IntersectionObserver(function(e){formIn=e[0].isIntersecting;up();},{threshold:.1}).observe(form);
  function up(){t=false;var past=hero?hero.getBoundingClientRect().bottom<innerHeight*.5:scrollY>innerHeight;
    var near=(innerHeight+scrollY)>=document.documentElement.scrollHeight-40,show=past&&!formIn&&!near;
    bar.classList.toggle('on',show);bar.setAttribute('aria-hidden',show?'false':'true');link.tabIndex=show?0:-1;}
  addEventListener('scroll',function(){if(!t){t=true;requestAnimationFrame(up);}},{passive:true});up();
})();
</script>
<script>
(function(){var w=document.getElementById('vp-attente');if(!w||w.dataset.vx)return;w.dataset.vx=1;var inr=w.querySelector('.in')||w;
  var k=inr.querySelector('.kicker');
  if(k){k.textContent='Bientôt disponible · 39,90 €';}
  /* Nike : on vend une identité, pas des accessoires */
  var h=inr.querySelector('h2');if(h)h.innerHTML='Deviens celle qui <em>tient son rendez-vous.</em>';
  var sb=inr.querySelector('p.sub');if(sb)sb.textContent='15 minutes par jour, chez toi. Laisse ton e-mail : tu seras prévenue en premier du lancement du kit VAURE.';
  var ul=document.createElement('ul');ul.className='wperks';
  ul.innerHTML='<li>Prévenue en premier, le jour du lancement</li><li><a href="/pages/les-exercices">Les exercices guidés</a> déjà accessibles, gratuitement</li><li>Désinscription en un clic</li>';
  var f=inr.querySelector('form');(f||inr).insertAdjacentElement(f?'afterend':'beforeend',ul);
  var ok=inr.querySelector('.msg.good');if(ok)ok.insertAdjacentHTML('beforeend',' En attendant, <a href="/pages/les-exercices">commence le jour 1</a>.');
})();
</script>
<script>
/* Un fil logique pour l'accueil : promesse → constat → le kit → la méthode → le défi → pour toutes → questions → inscription */
(function(){
  var home=document.querySelector('.vp');if(!home)return;
  function wrapOf(sel){var e=document.querySelector(sel);return e&&(e.closest('.shopify-section')||e);}
  function moveAfter(sel,afterSel){var el=home.querySelector(sel),ref=wrapOf(afterSel);if(!el||!ref||el.dataset.moved)return;el.dataset.moved=1;
    var w=document.createElement('div');w.className=home.className+' vp-moved';ref.parentNode.insertBefore(w,ref.nextSibling);w.appendChild(el);}
  moveAfter('.pain','.v3');      /* le constat, juste après la promesse */
  moveAfter('.prog','.vse');     /* le défi 30 jours, juste après la séance type */
})();
</script>
<script>
/* Petits mouvements : photos qui suivent la souris (ordinateur), chiffres de l'offre qui comptent */
(function(){
  if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  /* 1. Profondeur au survol, seulement avec une souris */
  if(window.matchMedia&&matchMedia('(hover:hover) and (pointer:fine)').matches){
    [].forEach.call(document.querySelectorAll('.vto figure,.vc-pc .ph,.vof .ph'),function(box){
      var img=box.querySelector('img');if(!img)return;img.style.transition='transform .7s cubic-bezier(.2,.8,.2,1)';img.style.willChange='transform';
      box.addEventListener('mousemove',function(e){var r=box.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
        img.style.transform='scale(1.07) translate('+(-x*14).toFixed(1)+'px,'+(-y*14).toFixed(1)+'px)';});
      box.addEventListener('mouseleave',function(){img.style.transform='';});
    });
  }
  /* 2. Les chiffres 8 · 30 · 15 de l'offre comptent quand on arrive dessus */
  var nums=[].slice.call(document.querySelectorAll('.vof li b'));
  if(nums.length&&window.IntersectionObserver){
    nums.forEach(function(b){b.dataset.to=b.textContent;b.textContent='0';});
    var io=new IntersectionObserver(function(es){if(!es[0].isIntersecting)return;io.disconnect();
      nums.forEach(function(b,k){var to=+b.dataset.to,t0=null;
        function st(ts){if(t0===null)t0=ts+k*120;var p=Math.max(0,Math.min(1,(ts-t0)/900));p=1-Math.pow(1-p,3);b.textContent=Math.round(to*p);if(p<1)requestAnimationFrame(st);}
        requestAnimationFrame(st);});},{threshold:.4});
    io.observe(nums[0].closest('ul'));
  }
})();
</script>
<script>
/* Coca-Cola : chaque bloc finit par une action. Le bouton suit l'état du produit (liste d'attente puis achat). */
(function(){
  {%- assign kit = all_products['kit-pilates-vaure'] -%}
  {%- capture bt -%}Je veux le kit · {{ kit.price | money }}{%- endcapture -%}
  var BUY={% if kit and kit.available %}{href:{{ kit.url | json }},t:{{ bt | json }}}{% else %}null{% endif %};
  var MAIN=BUY||{href:'#vp-attente',t:'Être prévenue du lancement'};
  var nv=document.querySelector('.vnv');if(nv&&!nv.id)nv.id='vp-niveau';
  var A=[
    ['.vp .pain .in',[{href:'#vp-offre',t:'Découvrir le kit · 39,90 €'}],false,false],
    ['.vc-pc',[{href:'#vp-offre',t:'Voir le kit et son prix'}],false,false],
    ['.vp .prog .in',[MAIN,{href:'/pages/les-exercices',t:'Commencer le jour 1',s:1}],true,false],
    ['.vto .in',[{href:'#vp-niveau',t:'Trouver mon niveau'},{href:'/pages/les-exercices',t:'Essayer le jour 1',s:1}],false,false],
    ['.vfo .in',[MAIN,{href:'/pages/notre-histoire',t:'Lire l\'histoire',s:1}],true,false],
    ['.vp .faq .in',[MAIN,{href:'/pages/nous-contacter',t:'Poser une autre question',s:1}],false,true]
  ];
  A.forEach(function(a){var box=document.querySelector(a[0]);if(!box||box.querySelector('.vnext'))return;
    var d=document.createElement('div');d.className='vnext'+(a[2]?' dk':'')+(a[3]?' ct':'');
    d.innerHTML=a[1].map(function(l){return '<a class="'+(l.s?'s':'p')+'" href="'+l.href+'">'+l.t+'</a>';}).join('');box.appendChild(d);});
  /* la citation du fondateur a déjà son lien « Lire l'histoire » : on le retire pour ne pas doubler */
  var w=document.querySelector('.vfo .who a');if(w)w.remove();
})();
</script>

