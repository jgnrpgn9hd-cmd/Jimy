{%- if section.settings.hide_old_kit -%}<style>.vp .kit{display:none}</style>{%- endif -%}
<style>
  .vk{--navy:#552b1d;--ink:#2b1710;--fluo:#2ef27a;--paper:#f4ece2;--muted:#7a5a48;position:relative;overflow:hidden;background:radial-gradient(120% 90% at 50% 40%,#fbf7f2 0%,var(--paper) 60%,#eadfd1 100%);font-family:'Inter',system-ui,-apple-system,sans-serif;color:var(--navy);-webkit-font-smoothing:antialiased;padding:110px 0 120px}
  .vk *{box-sizing:border-box}
  .vk-head{text-align:center;padding:0 20px;position:relative;z-index:2}
  .vk-head .k{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--muted);display:inline-flex;align-items:center;gap:10px}
  .vk-head .k::before{content:"";width:22px;height:2px;background:var(--fluo)}
  .vk-head h2{font-family:'Outfit',sans-serif;font-weight:600;font-size:clamp(30px,4vw,52px);letter-spacing:-.02em;line-height:1.05;margin:16px 0 0}
  .vk-stage{position:relative;margin-top:40px;height:clamp(230px,28vw,440px)}
  .vk-row{position:absolute;left:50%;top:50%;display:flex;align-items:center;white-space:nowrap;transform:translate(-50%,-50%);will-change:transform}
  .vk-l{font-family:'Outfit',sans-serif;font-weight:700;font-size:clamp(80px,16.5vw,270px);line-height:.8;letter-spacing:-.04em;color:var(--navy);user-select:none;transition:opacity .5s ease,filter .5s ease}
  .vk-i{all:unset;cursor:pointer;position:relative;z-index:2;display:block;margin:0 -2.2vw;transition:transform .5s cubic-bezier(.16,1,.3,1),opacity .5s ease,filter .5s ease}
  .vk-i svg{display:block;height:clamp(120px,19vw,310px);width:auto;filter:drop-shadow(0 30px 30px rgba(61,31,21,.30));animation:vkFloat 5s ease-in-out infinite;animation-delay:var(--d,0s)}
  .vk-i:hover{transform:translateY(-10px) rotate(-3deg) scale(1.04)}
  .vk-i:focus-visible{outline:3px solid var(--fluo);outline-offset:6px;border-radius:20px}
  .vk-i .dot{position:absolute;left:50%;top:-6px;transform:translateX(-50%);width:34px;height:34px;border-radius:50%;background:var(--fluo);color:var(--ink);display:grid;place-items:center;font-weight:700;font-size:20px;box-shadow:0 0 0 0 rgba(46,242,122,.6);animation:vkPing 2.2s ease-out infinite}
  @keyframes vkFloat{0%,100%{transform:translateY(0) rotate(var(--r,0deg))}50%{transform:translateY(-12px) rotate(var(--r,0deg))}}
  @keyframes vkPing{0%{box-shadow:0 0 0 0 rgba(46,242,122,.55)}80%,100%{box-shadow:0 0 0 18px rgba(46,242,122,0)}}
  .vk-hint{text-align:center;margin-top:34px;font-size:13px;color:var(--muted);position:relative;z-index:2}
  .vk-hint b{color:var(--ink)}

  /* Ouverture d'un élément */
  .vk-head,.vk-hint{transition:opacity .5s ease,filter .5s ease}
  .vk.open .vk-l,.vk.open .vk-i,.vk.open .vk-head,.vk.open .vk-hint{opacity:.12;filter:blur(6px)}
  .vk-ov{position:absolute;inset:0;z-index:5;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px;padding:40px 6vw;pointer-events:none;opacity:0;transition:opacity .45s ease}
  .vk.open .vk-ov{pointer-events:auto;opacity:1}
  .vk-big{justify-self:center;transform:translateX(-40px) scale(.7) rotate(-18deg);opacity:0;transition:transform .7s cubic-bezier(.16,1,.3,1),opacity .5s ease}
  .vk-big svg{display:block;height:min(62vh,520px);width:auto;max-width:100%;filter:drop-shadow(0 40px 40px rgba(61,31,21,.32))}
  .vk.open .vk-big{transform:none;opacity:1}
  .vk-card{max-width:440px;padding:34px;border-radius:26px;background:rgba(255,255,255,.62);border:1px solid rgba(255,255,255,.9);box-shadow:0 30px 70px rgba(61,31,21,.16);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);transform:translateX(50px);opacity:0;transition:transform .7s cubic-bezier(.16,1,.3,1) .08s,opacity .5s ease .08s}
  .vk.open .vk-card{transform:none;opacity:1}
  .vk-card .tag{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--muted)}
  .vk-card h3{color:var(--ink);font-family:'Outfit',sans-serif;font-size:clamp(28px,3vw,40px);font-weight:600;letter-spacing:-.02em;line-height:1.05;margin:10px 0 12px}
  .vk-card p{margin:0;color:var(--muted);font-size:15px;line-height:1.6}
  .vk-card ul{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:10px}
  .vk-card li{display:flex;gap:10px;align-items:center;font-size:14px;font-weight:500}
  .vk-card li::before{content:"✓";display:grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;background:var(--fluo);color:var(--ink);font-size:12px;font-weight:700}
  .vk-card .foot{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:26px;padding-top:20px;border-top:1px solid rgba(85,43,29,.12)}
  .vk-card .price{font-size:13px;color:var(--muted)}
  .vk-card .price b{display:block;font-family:'Outfit',sans-serif;font-size:26px;color:var(--navy);letter-spacing:-.02em}
  .vk-btn{display:inline-flex;align-items:center;gap:8px;background:var(--fluo);color:var(--ink);font-weight:600;font-size:14px;padding:14px 20px;border-radius:999px;text-decoration:none}
  .vk-nav{position:absolute;right:6vw;top:34px;display:flex;gap:10px}
  .vk-nav button{all:unset;cursor:pointer;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.75);border:1px solid rgba(85,43,29,.12);font-size:20px;color:var(--navy);transition:background .2s}
  .vk-nav button:hover{background:var(--fluo)}
  .vk-count{position:absolute;left:6vw;top:44px;font-size:12px;letter-spacing:.18em;font-weight:600;color:var(--muted)}

  @media (max-width:760px){
    .vk{padding:80px 0 90px}
    .vk-stage{height:200px;margin-top:20px}
    .vk-i{margin:0 -1.6vw}
    .vk-i svg{height:24vw}
    .vk-i .dot{width:28px;height:28px;font-size:17px}
    .vk-l{font-size:12.5vw}
    .vk-ov{position:fixed;z-index:1000;grid-template-columns:1fr;align-content:end;padding:80px 16px 16px;gap:0;background:rgba(244,236,226,.78);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
    .vk-big{position:absolute;top:76px;bottom:52vh;left:0;right:0;display:grid;place-items:center;transform:scale(.7) rotate(-18deg);justify-self:auto}
    .vk.open .vk-big{transform:none}
    .vk-big svg{height:100%;max-height:300px}
    .vk-card{max-width:none;padding:24px;transform:translateY(60px);position:relative;z-index:1}
    .vk-card h3{color:var(--ink);font-size:26px}
    .vk-nav{right:16px;top:18px}
    .vk-count{left:16px;top:32px}
  }
  @media (prefers-reduced-motion:reduce){.vk *{animation:none!important;transition:none!important}}
</style>

