<section class="vk" id="vp-kit">
  <div class="vk-head">
    <span class="k">Le kit</span>
    <h2>Tout le studio. Chez toi.</h2>
  </div>

  <div class="vk-stage">
    <div class="vk-row">
      <span class="vk-l" aria-hidden="true">V</span>
      <button class="vk-i" type="button" data-n="2" style="--r:-8deg;--d:0s" aria-label="Voir le cercle de Pilates"><span class="dot">+</span>{{ svg_cercle }}</button>
      <span class="vk-l" aria-hidden="true">AU</span>
      <button class="vk-i" type="button" data-n="1" style="--r:6deg;--d:-1.6s" aria-label="Voir le petit ballon"><span class="dot">+</span>{{ svg_ballon }}</button>
      <span class="vk-l" aria-hidden="true">RE</span>
      <button class="vk-i" type="button" data-n="0" style="--r:-6deg;--d:-3.2s" aria-label="Voir le tapis"><span class="dot">+</span>{{ svg_tapis }}</button>
    </div>
  </div>
  <p class="vk-hint"><b>Touche un élément</b> pour découvrir les 8 pièces du kit</p>

  <div class="vk-ov" role="dialog" aria-modal="false" aria-label="Détail du kit">
    <span class="vk-count">01 / 08</span>
    <div class="vk-nav"><button type="button" class="pv" aria-label="Précédent">←</button><button type="button" class="nx" aria-label="Suivant">→</button><button type="button" class="cl" aria-label="Fermer">×</button></div>
    <div class="vk-big"></div>
    <div class="vk-card">
      <span class="tag"></span>
      <h3></h3>
      <p></p>
      <ul></ul>
      <div class="foot">
        <span class="price">Inclus dans le kit<b>39,90 €</b></span>
        <a class="vk-btn" href="#vp-attente">Rejoindre la liste d'attente →</a>
      </div>
    </div>
  </div>

  <template class="vk-src">{{ svg_tapis }}</template>
  <template class="vk-src">{{ svg_ballon }}</template>
  <template class="vk-src">{{ svg_cercle }}</template>
  <template class="vk-src">{{ svg_bandes }}</template>
  <template class="vk-src">{{ svg_brique }}</template>
  <template class="vk-src">{{ svg_sliders }}</template>
  <template class="vk-src">{{ svg_rouleau }}</template>
  <template class="vk-src">{{ svg_prog }}</template>
</section>

<script>
(function(){
  var s=document.currentScript.previousElementSibling;if(!s||!s.classList.contains('vk'))return;
  var D=[
    {t:'La base',h:'Le tapis',p:"Ton espace de séance, prêt en deux secondes. Tu le déroules, tu commences, tu le ranges.",l:['Ta zone de séance, partout','Se roule et se range','Assorti au reste du kit']},
    {t:'Gainage',h:'Le petit ballon',p:"Entre les genoux, sous le dos ou dans les mains : il ajoute un peu d'instabilité pour faire travailler les muscles profonds.",l:['Abdos et dos','Intérieur des cuisses','Étirements accompagnés']},
    {t:'Résistance',h:'Le cercle de Pilates',p:"Tu le presses, tu l'écartes : il résiste à chaque mouvement. L'accessoire culte du Pilates.",l:['Bras et poitrine','Intérieur et extérieur des cuisses','Poignées rembourrées']},
    {t:'Intensité',h:'Les 3 bandes élastiques',p:"Trois couleurs, trois niveaux de résistance. Tu commences par la plus douce et tu progresses à ton rythme.",l:['3 niveaux de résistance','Fessiers et jambes','Progression à ton rythme']},
    {t:'Soutien',h:'La brique',p:"Elle t'aide à bien te placer : sous les mains, sous le bassin ou entre les genoux. Idéale quand on débute.",l:['Aide au placement','Débutante bienvenue','Légère et compacte']},
    {t:'Glisse',h:'Les 2 sliders',p:"Sous les mains ou sous les pieds, ils glissent au sol pour enchaîner les mouvements avec fluidité.",l:['Gainage','Fessiers et jambes','Mains ou pieds']},
    {t:'Récupération',h:'Le rouleau',p:"En fin de séance, pour relâcher le dos et les jambes en douceur.",l:['Fin de séance','Dos et jambes','Reliefs texturés']},
    {t:'Méthode',h:'Le programme vidéo',p:"15 minutes par jour, en français, de la première séance au défi final. Puis une nouvelle séance chaque semaine.",l:['Défi de 30 jours guidé','Débutante bienvenue','Une nouvelle séance chaque semaine']}
  ];
  var src=s.querySelectorAll('.vk-src'),big=s.querySelector('.vk-big'),card=s.querySelector('.vk-card'),cnt=s.querySelector('.vk-count'),row=s.querySelector('.vk-row'),cur=0;
  function fill(n){var N=D.length;cur=(n+N)%N;var d=D[cur];
    card.querySelector('.tag').textContent=d.t;card.querySelector('h3').textContent=d.h;card.querySelector('p').textContent=d.p;
    card.querySelector('ul').innerHTML=d.l.map(function(x){return '<li>'+x+'</li>'}).join('');
    big.innerHTML=src[cur].innerHTML;cnt.textContent='0'+(cur+1)+' / 0'+D.length;}
  function open(n){fill(n);s.classList.add('open');}
  function swap(n){s.classList.remove('open');setTimeout(function(){open(n)},260);}
  function close(){s.classList.remove('open');}
  s.querySelectorAll('.vk-i').forEach(function(b){b.addEventListener('click',function(){open(+b.dataset.n)})});
  s.querySelector('.nx').addEventListener('click',function(){swap(cur+1)});
  s.querySelector('.pv').addEventListener('click',function(){swap(cur-1)});
  s.querySelector('.cl').addEventListener('click',close);
  s.querySelector('.vk-btn').addEventListener('click',close);
  s.querySelector('.vk-ov').addEventListener('click',function(e){if(e.target===this)close()});
  document.addEventListener('keydown',function(e){if(!s.classList.contains('open'))return;if(e.key==='Escape')close();if(e.key==='ArrowRight')swap(cur+1);if(e.key==='ArrowLeft')swap(cur-1)});
  /* le mot glisse doucement au défilement, comme sur la vidéo */
  if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  var tk=false;function mv(){tk=false;var r=s.getBoundingClientRect(),h=innerHeight,p=(h-r.top)/(h+r.height);p=p<0?0:p>1?1:p;
    var amp=innerWidth<761?0:8;row.style.transform='translate(calc(-50% + '+((.5-p)*amp).toFixed(2)+'vw),-50%)';}
  addEventListener('scroll',function(){if(!tk){tk=true;requestAnimationFrame(mv)}},{passive:true});mv();
})();
</script>

