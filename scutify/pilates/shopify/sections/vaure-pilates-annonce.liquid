<style>
  .van{background:#2b1710;color:#fbf7f2;font-family:'Inter',system-ui,sans-serif;font-size:13px;line-height:1.3;overflow:hidden;-webkit-font-smoothing:antialiased}
  .van .tr{display:flex;width:max-content;animation:vanr 32s linear infinite}
  .van .tr:hover{animation-play-state:paused}
  .van span{display:inline-flex;align-items:center;gap:10px;padding:10px 26px;white-space:nowrap}
  .van span::before{content:"";width:6px;height:6px;border-radius:50%;background:#2ef27a}
  .van a{color:#2ef27a;font-weight:600;text-decoration:none}
  @keyframes vanr{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.van .tr{animation:none;flex-wrap:wrap;justify-content:center;width:auto}.van .tr span:nth-child(n+4){display:none}}
</style>
<div class="van" role="region" aria-label="Informations VAURE">
  <div class="tr">
    {%- for i in (1..2) -%}
      <span>Lancement du kit très bientôt · <a href="#vp-attente"{% if i == 2 %} tabindex="-1" aria-hidden="true"{% endif %}>Être prévenue</a></span>
      <span>Les exercices guidés sont déjà gratuits · <a href="/pages/les-exercices"{% if i == 2 %} tabindex="-1" aria-hidden="true"{% endif %}>Essayer</a></span>
      <span>Retours sous 30 jours</span>
      <span>Le kit complet : 39,90 €, une seule fois</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "VAURE – annonce",
  "settings": [],
  "presets": [{ "name": "VAURE – annonce" }]
}
{% endschema %}
