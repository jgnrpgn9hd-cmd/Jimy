<style>
  /* 1. Comparatif lisible sur téléphone : on garde Studio face à VAURE */
  @media (max-width:760px){
    .vp table{min-width:0}
    .vp th:nth-child(3),.vp td:nth-child(3),.vp th:nth-child(4),.vp td:nth-child(4){display:none}
    .vp th,.vp td{padding:16px 10px;font-size:14px}
    .vp th:first-child,.vp td:first-child{width:46%}
  }
  /* 2. Défi 30 jours plus compact sur téléphone : 2 colonnes, moins de vide */
  @media (max-width:900px){
    .vp .timeline{grid-template-columns:1fr 1fr!important;row-gap:32px;column-gap:18px;margin-top:40px;padding-top:0}
    .vp .step::before{margin-bottom:10px}
    .vp .step h3{font-size:19px;margin:6px 0 4px}
    .vp .step p{font-size:14px}
  }
  /* 3. Barre d'action collante sur téléphone */
  .vsb{position:fixed;left:12px;right:12px;bottom:12px;z-index:60;display:none;align-items:center;gap:12px;padding:10px 10px 10px 18px;border-radius:999px;background:rgba(43,23,16,.92);-webkit-backdrop-filter:blur(14px) saturate(1.3);backdrop-filter:blur(14px) saturate(1.3);color:#fbf7f2;font-family:'Inter',system-ui,sans-serif;box-shadow:0 14px 40px rgba(43,23,16,.3);transform:translateY(140%);transition:transform .45s cubic-bezier(.2,.9,.25,1)}
  .vsb.on{transform:none}
  .vsb p{margin:0;flex:1;font-size:13px;line-height:1.3}
  .vsb p b{display:block;font-family:'Outfit',sans-serif;font-size:15px;font-weight:600}
  .vsb a{flex:none;background:#2ef27a;color:#2b1710;font-weight:600;font-size:14px;padding:12px 18px;border-radius:999px;text-decoration:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation;transition:transform .1s ease-out}
  .vsb a:active{transform:scale(.96)}
  @media (max-width:760px){.vsb{display:flex}}
  @media (prefers-reduced-motion:reduce){.vsb{transition:none}}
</style>

<div class="vsb" aria-hidden="true">
  <p><b>Le kit VAURE</b>Lancement très bientôt</p>
  <a href="#vp-attente" tabindex="-1">Me prévenir</a>
</div>

<script>
(function(){
  var bar=document.querySelector('.vsb');if(!bar||!('IntersectionObserver' in window))return;
  var hero=document.querySelector('.v3'),wait=document.getElementById('vp-attente'),pastHero=false,atWait=false;
  function upd(){var on=pastHero&&!atWait;bar.classList.toggle('on',on);bar.setAttribute('aria-hidden',on?'false':'true');bar.querySelector('a').tabIndex=on?0:-1;}
  if(hero)new IntersectionObserver(function(e){pastHero=!e[0].isIntersecting&&e[0].boundingClientRect.top<0;upd();}).observe(hero);else pastHero=true;
  if(wait)new IntersectionObserver(function(e){atWait=e[0].isIntersecting;upd();},{rootMargin:'0px 0px -20% 0px'}).observe(wait);
  upd();
})();
</script>

{% schema %}
{
  "name": "VAURE – retouches",
  "settings": [],
  "presets": [{ "name": "VAURE – retouches" }]
}
{% endschema %}
