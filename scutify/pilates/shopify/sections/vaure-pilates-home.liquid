<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@400;500;600&display=swap">
<style>
  .vp{--navy:#552b1d;--navy2:#6a3726;--ink:#2b1710;--white:#ffffff;--paper:#f4ece2;--fluo:#2ef27a;--muted:#7a5a48;--line:#e7dccd;--soft:#dcc7b4;
      font-family:'Inter',system-ui,-apple-system,sans-serif;color:var(--ink);background:var(--white);line-height:1.6;-webkit-font-smoothing:antialiased;overflow:hidden}
  .vp *{box-sizing:border-box}
  .vp h1,.vp h2,.vp h3{font-family:'Outfit','Inter',sans-serif;letter-spacing:-.02em;margin:0;text-wrap:balance}
  .vp p{margin:0}
  .vp section{scroll-margin-top:90px}
  .vp .in{max-width:1200px;margin:0 auto;padding:0 24px}
  .vp .kicker{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--muted);display:flex;align-items:center;gap:10px}
  .vp .kicker::before{content:"";width:24px;height:2px;background:var(--fluo)}
  .vp .btn{display:inline-flex;align-items:center;gap:10px;background:var(--fluo);color:var(--navy);font-weight:600;padding:16px 26px;border-radius:999px;text-decoration:none;border:0;cursor:pointer;font-size:15px;transition:transform .25s ease,box-shadow .25s ease}
  .vp .btn svg{transition:transform .25s ease}
  .vp .btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(46,242,122,.35)}
  .vp .btn:hover svg{transform:translateX(4px)}
  .vp .btn,.vp summary{-webkit-tap-highlight-color:transparent;touch-action:manipulation}
  .vp .btn:active{transform:scale(.97);box-shadow:none;transition-duration:.1s}
  .vp .faq summary:active i{transform:scale(.9)}
  .vp .btn:focus-visible,.vp input:focus-visible,.vp summary:focus-visible{outline:2px solid var(--fluo);outline-offset:4px}

  .vp .hero{background:var(--navy);color:var(--white)}
  .vp .hero .in{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;padding-top:96px;padding-bottom:88px}
  .vp .hero .kicker{color:var(--soft)}
  .vp .hero h1{font-size:clamp(44px,7vw,92px);font-weight:600;line-height:.98;margin:22px 0 26px}
  .vp .hero h1 .l2{color:var(--fluo);font-weight:300;display:block}
  .vp .hero .lead{font-size:18px;color:var(--soft);max-width:34ch}
  .vp .hero .row{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:36px}
  .vp .hero .row .soon{font-size:14px;color:var(--soft)}
  .vp .hero .meta{display:flex;gap:28px;margin-top:56px;padding-top:24px;border-top:1px solid rgba(255,255,255,.12);font-size:13px;color:var(--soft)}
  .vp .hero .meta b{display:block;font-family:'Outfit',sans-serif;font-size:26px;color:var(--white);font-weight:600;letter-spacing:-.02em}
  .vp .art{width:100%;max-width:520px;justify-self:end;aspect-ratio:1/1}
  .vp .art svg{width:100%;height:100%;display:block}

  .vp .marquee{background:var(--fluo);color:var(--navy);overflow:hidden;white-space:nowrap}
  .vp .marquee .track{display:inline-flex;gap:40px;padding:14px 0;animation:vp-marquee 30s linear infinite}
  .vp .marquee span{font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;letter-spacing:.12em;text-transform:uppercase;display:inline-flex;align-items:center;gap:40px}
  .vp .marquee span::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--navy)}

  .vp .pain{padding:120px 0}
  .vp .pain .grid{display:grid;grid-template-columns:1.25fr .75fr;gap:72px;align-items:end}
  .vp .pain h2{font-size:clamp(32px,4.4vw,58px);font-weight:600;line-height:1.05;margin-top:22px}
  .vp .pain h2 em{font-style:normal;color:var(--muted);font-weight:300}
  .vp .facts{display:grid;gap:28px}
  .vp .fact{border-top:1px solid var(--line);padding-top:18px}
  .vp .fact .n{font-family:'Outfit',sans-serif;font-size:52px;font-weight:600;letter-spacing:-.03em;line-height:1}
  .vp .fact .n small{font-size:20px;font-weight:400;color:var(--muted);margin-left:6px;letter-spacing:0}
  .vp .fact p{color:var(--muted);margin-top:8px;font-size:15px}
  .vp .fact.good .n span{background:linear-gradient(transparent 84%,var(--fluo) 84%);padding-bottom:2px}

  .vp .kit{background:var(--paper);padding:120px 0}
  .vp .kit .head{display:flex;justify-content:space-between;align-items:end;gap:40px;flex-wrap:wrap}
  .vp .kit h2,.vp .prog h2,.vp .compare h2,.vp .faq h2{font-size:clamp(30px,4vw,52px);font-weight:600;line-height:1.05;margin-top:20px}
  .vp .kit h2{max-width:16ch}
  .vp .kit .head p{color:var(--muted);max-width:42ch}
  .vp .items{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:64px}
  .vp .item{background:var(--white);border-radius:24px;padding:28px;transition:transform .35s ease,box-shadow .35s ease}
  .vp .item:hover{transform:translateY(-6px);box-shadow:0 24px 50px rgba(85,43,29,.12)}
  .vp .item .pic{aspect-ratio:4/3;border-radius:16px;background:var(--navy);display:grid;place-items:center;margin-bottom:24px}
  .vp .item .pic svg{width:78%;height:auto}
  .vp .item .tag{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600}
  .vp .item h3{font-size:24px;font-weight:600;margin:6px 0 8px}
  .vp .item p{color:var(--muted);font-size:15px}

  .vp .prog{background:var(--navy);color:var(--white);padding:120px 0}
  .vp .prog .kicker{color:var(--soft)}
  .vp .prog h2 .f{color:var(--fluo)}
  .vp .timeline{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:72px;padding-top:40px}
  .vp .timeline::before{content:"";position:absolute;top:8px;left:0;right:0;height:2px;background:rgba(255,255,255,.14)}
  .vp .timeline .bar{position:absolute;top:8px;left:0;height:2px;width:100%;background:var(--fluo);transform-origin:left}
  .vp .step{position:relative}
  .vp .step::before{content:"";position:absolute;top:-38px;left:0;width:14px;height:14px;border-radius:50%;background:var(--navy);border:2px solid var(--fluo)}
  .vp .step .d{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--fluo);font-weight:600}
  .vp .step h3{font-size:24px;font-weight:600;margin:10px 0 8px}
  .vp .step p{color:var(--soft);font-size:15px}

  .vp .compare{padding:120px 0}
  .vp .compare h2{max-width:18ch}
  .vp .tbl{overflow-x:auto;margin-top:56px}
  .vp table{border-collapse:separate;border-spacing:0;width:100%;min-width:640px}
  .vp th,.vp td{text-align:center;padding:20px 16px;border-bottom:1px solid var(--line);font-size:15px}
  .vp th:first-child,.vp td:first-child{text-align:left;color:var(--muted)}
  .vp thead th{font-family:'Outfit',sans-serif;font-size:17px;font-weight:600;color:var(--ink)}
  .vp th.us,.vp td.us{background:var(--navy);color:var(--white);border-bottom-color:rgba(255,255,255,.12)}
  .vp thead .us{border-radius:20px 20px 0 0}
  .vp tbody tr:last-child .us{border-radius:0 0 20px 20px}
  .vp .ok,.vp .no{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;font-size:14px;font-weight:700;color:var(--navy)}
  .vp .ok{background:var(--fluo)}
  .vp .no{background:var(--paper)}
  .vp .no::before{content:"";width:10px;height:2px;background:var(--soft)}

  .vp .faq{background:var(--paper);padding:120px 0}
  .vp .faq .grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:72px;align-items:start}
  .vp .faq .side{position:sticky;top:120px}
  .vp .faq .side p{color:var(--muted);margin-top:16px;max-width:34ch}
  .vp .faq details{border-bottom:1px solid var(--line)}
  .vp .faq summary{font-family:'Outfit',sans-serif;font-size:20px;font-weight:600;letter-spacing:-.01em;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 0}
  .vp .faq summary::-webkit-details-marker{display:none}
  .vp .faq summary i{flex:none;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);position:relative;transition:background .3s ease}
  .vp .faq summary i::before,.vp .faq summary i::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:2px;background:var(--ink);transform:translate(-50%,-50%)}
  .vp .faq summary i::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .3s ease}
  .vp .faq details[open] summary i{background:var(--fluo);border-color:var(--fluo)}
  .vp .faq details[open] summary i::after{transform:translate(-50%,-50%) rotate(0)}
  .vp .faq details p{color:var(--muted);padding:0 56px 24px 0;animation:vp-fade .4s ease both}
  .vp .safe{display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:start;margin-top:40px;padding:22px;border-radius:18px;background:var(--white);font-size:14px;color:var(--muted)}
  .vp .safe b{color:var(--ink)}

  .vp .promises{display:grid;grid-template-columns:repeat(3,1fr)}
  .vp .promises div{padding:36px 24px;border-right:1px solid var(--line)}
  .vp .promises div:last-child{border-right:0}
  .vp .promises b{display:block;font-family:'Outfit',sans-serif;font-size:20px;font-weight:600;letter-spacing:-.01em}
  .vp .promises span{color:var(--muted);font-size:14px}

  .vp .wait{background:var(--navy);color:var(--white);padding:128px 0}
  .vp .wait .in{max-width:860px;text-align:center}
  .vp .wait .kicker{justify-content:center;color:var(--soft)}
  .vp .wait h2{font-size:clamp(36px,5.5vw,72px);font-weight:600;line-height:1;margin-top:22px}
  .vp .wait h2 em{font-style:normal;color:var(--fluo);font-weight:300}
  .vp .wait p.sub{color:var(--soft);margin:20px auto 0;max-width:46ch}
  .vp .wait .field{display:flex;gap:8px;max-width:520px;margin:44px auto 0;padding:6px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16)}
  .vp .wait input[type=email]{flex:1;min-width:0;background:transparent;border:0;color:var(--white);padding:14px 20px;font-size:16px}
  .vp .wait input::placeholder{color:var(--soft)}
  .vp .wait .msg{margin-top:18px;font-weight:600}
  .vp .wait .msg.good{color:var(--fluo)}
  .vp .wait .msg.bad{color:#ffb4b4}

  @keyframes vp-marquee{to{transform:translateX(-50%)}}
  @keyframes vp-fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @keyframes vp-rise{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:none}}
  @keyframes vp-draw{from{stroke-dashoffset:var(--len)}to{stroke-dashoffset:0}}
  @keyframes vp-spin{to{transform:rotate(360deg)}}
  @keyframes vp-breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
  .vp .hero .kicker,.vp .hero h1,.vp .hero .lead,.vp .hero .row,.vp .hero .meta{animation:vp-rise 1s cubic-bezier(.16,1,.3,1) both}
  .vp .hero h1{animation-delay:.08s}.vp .hero .lead{animation-delay:.2s}.vp .hero .row{animation-delay:.32s}.vp .hero .meta{animation-delay:.44s}
  .vp .art .ring{transform-origin:260px 260px;animation:vp-spin 60s linear infinite}
  .vp .art .halo{transform-origin:260px 260px;animation:vp-breathe 6s ease-in-out infinite}
  .vp .art .draw{stroke-dasharray:var(--len);animation:vp-draw 1.6s cubic-bezier(.65,0,.35,1) both}
  .vp-js .rv{opacity:0;transform:translateY(36px);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1);transition-delay:calc(var(--i,0) * 110ms)}
  .vp-js .rv.is-in{opacity:1;transform:none}
  .vp-js .timeline .bar{transform:scaleX(0);transition:transform 1.8s cubic-bezier(.65,0,.35,1) .3s}
  .vp-js .timeline.is-in .bar{transform:scaleX(1)}
  @media (prefers-reduced-motion:reduce){.vp *{animation:none!important;transition:none!important}.vp-js .rv{opacity:1;transform:none}.vp-js .timeline .bar{transform:none}.vp .art .draw{stroke-dasharray:none}}

  @media (max-width:900px){
    .vp .hero .in,.vp .pain .grid,.vp .faq .grid{grid-template-columns:1fr;gap:40px}
    .vp .hero .in{padding-top:56px;padding-bottom:64px}
    .vp .art{max-width:320px;justify-self:center;order:-1}
    .vp .items,.vp .promises{grid-template-columns:1fr}
    .vp .promises div{border-right:0;border-bottom:1px solid var(--line)}
    .vp .timeline{grid-template-columns:1fr 1fr;row-gap:48px}
    .vp .timeline::before,.vp .timeline .bar{display:none}
    .vp .step::before{position:static;display:block;margin-bottom:14px}
    .vp .pain,.vp .kit,.vp .prog,.vp .compare,.vp .faq{padding:80px 0}
    .vp .wait{padding:88px 0}
    .vp .faq .side{position:static}
    .vp .hero .meta{gap:20px;flex-wrap:wrap}
    .vp .fact .n{font-size:42px}
  }
  @media (max-width:520px){.vp .timeline{grid-template-columns:1fr}.vp .wait .field{flex-direction:column;border-radius:24px}.vp .wait .btn{justify-content:center}}
</style>

